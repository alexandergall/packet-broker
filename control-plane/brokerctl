#!/usr/bin/env python3
import argparse
import sys
import logging
import socket
import json

def show(args):
    return { 'processed': args.processed }

def add_remove(args):
    command = args.command_1
    if command == 'source-filter':
        return json.dumps(args.prefix)
    if command == 'flow-mirror':
        if args.command_0 == "add":
            values = args.flow
        else:
            values = args.uuid
        try:
            data = [ json.loads(value) for value in values ]
        except json.JSONDecodeError as e:
            print(f"Invalid JSON encoding of input: {e}")
            sys.exit(3)
        return json.dumps(data)

def create_subparser(prsr, spec, level = 0):
    for name, args in spec.get('arguments', {}).items():
        prsr.add_argument(name, **args)
    if 'commands' in spec:
        prsr.set_defaults(subcommands=True)
        sprsr = prsr.add_subparsers(help = spec.get('help', None),
                                    dest = 'command_' + str(level),
                                    description = spec.get('description', None),
                                    title = spec.get('title', None))
        for command, spec in spec['commands'].items():
            prsr = sprsr.add_parser(command, help = spec['help'])
            prsr.set_defaults(prsr=prsr, level=level+1)
            if spec.get('func', None) is not None:
                prsr.set_defaults(func=spec['func'])
            create_subparser(prsr, spec, level+1)
    else:
        prsr.set_defaults(subcommands=False)

def request(host, args):
    req = {
        'commands': [],
        'args': {}
    }

    for i in range(args.level):
        command = getattr(args, 'command_'+str(i), None)
        req['commands'].append(command)

    if args.subcommands and len(req['commands']) <= args.level:
        args.prsr.print_help(sys.stderr)
        sys.exit(2)

    req['args'] = args.func(args)
    try:
        addrinfo = socket.getaddrinfo(host, args.port, type = socket.SOCK_STREAM)
    except Exception as e:
        logger.error(f'{host}: {e}')
        sys.exit(2)
    for info in addrinfo:
        logger.info("Trying {}".format(info[4][0]))
        s = socket.socket(info[0], info[1])
        s.connect(info[4])
        logger.info("Connected")
        s.send((json.dumps(req) + "\n").encode())
        f = s.makefile()
        line = f.readline()
        resp = json.loads(line)
        s.close()
        return(resp)

