{
    "$schema": "http://json-schema.org/schema#",
    "$id": "http://switch.ch/schemas/packet_broker.json",

    "definitions": {
        "mac-address-pool": {
            "type": "object",
            "required": [ "base", "size" ],
            "properties": {
                "base": {
                    "$ref": "#/definitions/mac-address-pattern"
                },
                "size": {
                    "type": "integer"
                }
            },
            "additionalProperties": false
        },

        "interface-config": {
            "type": "object",
            "required": [ "speed", "mtu" ],
            
            "properties": {
                "description": {
                    "type": "string"
                },

                "speed": {
                    "type": "string",
                    "enum": [
                        "BF_SPEED_1G",
                        "BF_SPEED_10G",
                        "BF_SPEED_25G",
                        "BF_SPEED_40G",
                        "BF_SPEED_40G_NB",
                        "BF_SPEED_40G_NON_BREAKABLE",
                        "BF_SPEED_50G",
                        "BF_SPEED_50G_R1",
                        "BF_SPEED_100G",
                        "BF_SPEED_100G_R2",
                        "BF_SPEED_200G",
                        "BF_SPEED_200G_R8",
                        "BF_SPEED_400G"
                    ]
                },
                
                "fec": {
                    "type": "string",
                    "enum": [
                        "BF_FEC_TYP_NONE",
                        "BF_FEC_TYP_FIRECODE",
                        "BF_FEC_TYP_REED_SOLOMON",
                        "BF_FEC_TYP_FC",
                        "BF_FEC_TYP_RS"
                    ]
                },

                "mtu": {
                    "type": "integer",
                    "minimum": 1200,
                    "maximum": 10240
                },

                "shutdown": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        
        "port": {
            "type": "object",
            "patternProperties": {
                "^([0-9]+/[0-9]+|EthCPU[0-9])$": {
                    "type": "object",
                    "required": [ "config" ],

                    "properties": {
                        "config": {
                            "$ref": "#/definitions/interface-config"
                        }
                    },
                    "additionalProperties": false
                }
            }
        },

        "port-pattern": {
            "type": "string",
            "pattern": "^([0-9]+/[0-9]+|EthCPU[0-9])$"
        },

        "port-pattern-with-pciecpu": {
            "type": "string",
            "pattern": "^([0-9]+/[0-9]+|EthCPU[0-9]|PCIeCPU)$"
        },

        "vlan": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4095
        },

        "port-spec": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                },
                "mask": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                }
            }
        },

        "mac-address-pattern": {
            "type": "string",
            "pattern": "^([a-f0-9]{2}:){5}([a-f0-9]){2}$"
        },

        "mac-rewrite": {
            "type": "object",
            "patternProperties": {
                "^([a-f0-9]{2}:){5}[a-f0-9]{2}$": {
                    "$ref": "#/definitions/mac-address-pattern"
                }
            },
            "additionalProperties": false
        }
    },
    
    "type": "object",
    "required": [ "ports" ],
    
    "properties": {
        "system": {
            "type": "object",

            "properties": {
                "mac-address-pools": {
                    "type": "object",
                    "required": [ "port", "system" ],

                    "properties": {
                        "port": {
                            "$ref": "#/definitions/mac-address-pool"
                        },
                        "system": {
                            "$ref": "#/definitions/mac-address-pool"
                        }
                    },
                    "additionalProperties": false
                },
                "ip": {
                    "type": "object",
                    "required": [ "addressv4", "addressv6" ],

                    "properties":  {
                        "addressv4": {
                            "type": "string"
                        },
                        "addressv6": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },

        "ports": {
            "type": "object",
            "required": [ "ingress", "egress" ],
            
            "properties": {
                "ingress": {
                    "type": "object",
                    "patternProperties": {
                        "^([0-9]+/[0-9]+|EthCPU[0-9])$": {
                            "type": "object",
                            "required": [ "config", "egress-group", "vlans" ],

                            "properties": {
                                "config": {
                                    "$ref": "#/definitions/interface-config"
                                },
                                
                                "egress-group": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                
                                "vlans": {
                                    "type": "object",

                                    "properties": {
                                        "push": {
                                            "$ref": "#/definitions/vlan"
                                        },

                                        "accept": {
                                            "type": "array",

                                            "items": {
                                                "type": "object",
                                                "required": [ "vid" ],
                                                "properties": {
                                                    "vid": {
                                                        "type": "integer",
                                                        "minimum": 0,
                                                        "maximum": 4095
                                                    },
                                                    "mask": {
                                                        "type": "integer",
                                                        "minimum": 0,
                                                        "maximum": 4095
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        },

                                        "rewrite": {
                                            "type": "array",

                                            "items": {
                                                "type": "object",
                                                "required": [ "in", "out" ],
                                                "properties": {
                                                    "in": {
                                                        "$ref": "#/definitions/vlan"
                                                    },
                                                    "out": {
                                                        "$ref": "#/definitions/vlan"
                                                    },
                                                    "mac-rewrite": {
                                                        "type": "object",
                                                        "properties": {
                                                            "src": {
                                                                "$ref": "#/definitions/mac-rewrite"
                                                            },
                                                            "dst": {
                                                                "$ref": "#/definitions/mac-rewrite"
                                                            }
                                                        },
                                                        "additionalProperties": false
                                                    }
                                                },
                                                "additionalProperties": false
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "additionalProperties": false
                },
                
                "egress": {
                    "type": "array",
                    
                    "items": {
                        "type": "object",
                        "required": [ "group-id", "members" ],
                        
                        "properties": {
                            "group-id": {
                                "type": "integer",
                                "minimum": 1
                            },
                            
                            "members": {
                                "$ref": "#/definitions/port"
                            }
                        },
                        "additionalProperties": false
                    }
                },

                "other": {
                    "$ref": "#/definitions/port"
                }
                
            }
        },
        "source-filter": {
            "type": "array",
            
            "items": {
                "type": "string"
            }
        },

        "monitor-sessions": {
            "type": "object",

            "patternProperties": {
                "^[a-zA-z0-9_-]+$": {
                    "type": "object",
                    "required": [ "egress-port" ],

                    "properties": {
                        "encapsulation": {
                            "type": "object",
                            "properties": {
                                "erspan": {
                                    "type": "object",
                                    "required": [ "session-id", "ethernet", "ip" ],

                                    "properties": {
                                        "session-id": {
                                            "type": "integer",
                                            "minimum": 0,
                                            "maximum": 1023
                                        },
                                        "ethernet": {
                                            "type": "object",
                                            "required": [ "dst" ],
                                            "properties": {
                                                "dst": {
                                                    "$ref": "#/definitions/mac-address-pattern"
                                                },
                                                "vlan": {
                                                    "$ref": "#/definitions/vlan"
                                                }
                                            },
                                            "additionalProperties": false
                                        },
                                        "ip": {
                                            "type": "object",
                                            "required": [ "dst" ],
                                            "properties": {
                                                "dst": {
                                                    "type": "string"
                                                },
                                                "ttl": {
                                                    "type": "integer",
                                                    "minimum": 1,
                                                    "maximum": 255
                                                }
                                            },
                                            "additionalProperties": false
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "oneOf": [
                                { "required": [ "erspan" ] }
                            ]
                        },
                        "egress-port": {
                            "$ref": "#/definitions/port-pattern-with-pciecpu"
                        },
                        "max-packet-length": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 16384
                        }
                    },
                    "additionalProperties": false
                },
                "additionalProperties": false
            },
            "additionalProperties": false
        },

        "flow-mirror": {
            "type": "array",

            "items": {
                "type": "object",
                "required": [ "monitor-session" ],

                "properties": {
                    "monitor-session": {
                        "type": "string",
                        "pattern": "^[a-zA-z0-9_-]+$"
                    },
		    "ingress-ports": {
			"type": "array",

			"items": {
			    "$ref": "#/definitions/port-pattern"
			}
		    },
                    "mirror-mode": {
                        "type": "string",
                        "enum": [
                            "ingress",
                            "egress"
                        ]
                    },
                    "non-ip": {
			"type": "boolean"
		    },
                    "src": {
                        "type": "string"
                    },
                    "dst": {
                        "type": "string"
                    },
                    "src_port": {
                        "$ref": "#/definitions/port-spec"
                    },
                    "dst_port": {
                        "$ref": "#/definitions/port-spec"
                    },
                    "bidir": {
                        "type": "boolean"
                    },
                    "enable": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false
            }
        },
        
        "features": {
            "type": "object",
            
            "properties": {
                "deflect-on-drop": {
                    "$ref": "#/definitions/port-pattern-with-pciecpu"
                },

                "drop-non-initial-fragments": {
                    "type": "boolean"
                },
                
                "exclude-ports-from-hash": {
                    "type": "boolean"
                },

                "drop-non-ip": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
