    "required": [ "ports" ],

    "properties": {
        "system": {
            "type": "object"
        },
        "ports": {
            "type": "object"
        },
        "source-filter": {
            "type": "array"
        },
        "monitor-sessions": {
            "type": "object"
        },
        "flow-mirror": {
            "type": "array"
        },
        "features": {
            "type": "object"
        }
    },
    "additionalProperties": false
}
